# 复制为 .env 后填入真实密钥：cp .env.example .env
# 本地后端（uvicorn --env-file ../.env）与 docker compose 变量插值共用本文件；.env 已被 .gitignore 忽略
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# 可选：预算闸门（默认 30000 tokens/回合、10 美元/战役；调大即放宽，设极大值 = 事实关闭）
# ENSEMBLE_TURN_TOKEN_CAP=30000
# ENSEMBLE_CAMPAIGN_COST_CAP_USD=10
